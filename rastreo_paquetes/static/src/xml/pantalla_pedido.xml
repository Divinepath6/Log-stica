<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="rastreo_paquetes.PdfUploader">
        <div class="odoo-pdf-uploader">

            <t t-if="state.cargando">
                <span class="odoo-pdf-loading">
                    <i class="fa fa-spinner fa-spin"/> Cargando datos...
                </span>
            </t>

            <t t-else="">
                <span t-if="state.pedido" class="odoo-pdf-badge">
                    Guía: <t t-esc="state.pedido.numero_guia"/>
                </span>

                <button type="button"
                        class="odoo-btn odoo-btn-ghost odoo-btn-sm"
                        t-on-click="onAbrirSelectorPDF">
                    <i class="fa fa-file-pdf-o"/>
                    <span>
                        <t t-if="state.pedido &amp;&amp; state.pedido[props.name]">Reemplazar PDF</t>
                        <t t-else="">Agregar PDF</t>
                    </span>
                </button>

                <t t-if="state.pedido &amp;&amp; state.pedido[props.name]">
                    <button type="button"
                            class="odoo-btn odoo-btn-secondary odoo-btn-sm"
                            t-on-click="onClickVerPDF">
                        <i class="fa fa-eye"/>
                        <span>Ver PDF</span>
                    </button>
                </t>
            </t>

            <input type="file"
                   accept=".pdf,application/pdf"
                   t-ref="selectorPDF"
                   t-on-change="onPDFSeleccionado"
                   class="odoo-hidden"/>
        </div>
    </t>
</templates>