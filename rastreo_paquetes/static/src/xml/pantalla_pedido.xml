<t t-name="rastreo_paquetes.PdfUploader">
    <div class="pdf-container d-flex align-items-center gap-2">

        <t t-if="state.cargando">
            <span class="text-muted fs-7">
                <i class="fa fa-spinner fa-spin me-1"/> Cargando datos...
            </span>
        </t>

        <t t-else="">
            <span t-if="state.pedido" class="badge bg-light text-dark me-2">
                Guía: <t t-esc="state.pedido.numero_guia"/>
            </span>

            <button type="button"
                    class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1"
                    t-on-click="onAbrirSelectorPDF">
                <i class="fa fa-file-pdf-o"/>
                <span>
                    <t t-if="state.pedido &amp;&amp; state.pedido[props.name]">Reemplazar PDF</t>
                    <t t-else="">Agregar PDF</t>
                </span>
            </button>

            <t t-if="state.pedido &amp;&amp; state.pedido[props.name]">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                        t-on-click="onClickVerPDF">
                    <i class="fa fa-eye"/>
                    <span>Ver PDF</span>
                </button>
            </t>
        </t>

        <input type="file"
               accept=".pdf,application/pdf"
               t-ref="selectorPDF"
               t-on-change="onPDFSeleccionado"
               class="d-none"/>
    </div>
</t>