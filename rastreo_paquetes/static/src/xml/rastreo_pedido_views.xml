<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rastreo_pedido_form" model="ir.ui.view">

        <field name="name">rastreo.pedido.form</field>

        <field name="model">rastreo.pedido</field>

        <field name="arch" type="xml">

            <form string="Pedido" create="0">
                <header>
                    <button
                        name="%(action_pantalla_principal)d"
                        type="action"
                        string="Pantalla Principal"
                        class="oe_highlight"
                        icon="fa-home"
                    />

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="numero_guia"/>
                           <!--    <field name="cliente_id"/>      -->
                            <field name="estado"/>
                        </group>

                        <group>
                           <!-- <field name="anticipo_cliente"/>
                            <field name="anticipo_proveedor"/>
                            <field name="fecha_actualizacion"/> -->
                        </group>

                    </group>

                </sheet>

            </form>

        </field>

    </record>

</odoo>