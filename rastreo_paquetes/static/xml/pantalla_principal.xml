<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rastreo_paquetes.PantallaPrincipal">
        <div class="pantalla-principal">

            <!-- Título -->
            <h1 class="titulo">
                Pantalla principal
            </h1>


            <!-- Contenedor general -->
            <div class="contenedor-rastreo">

                <!-- Barra de búsqueda -->
                <div class="barra-busqueda">

                    <span class="icono-busqueda">
                        🔍
                    </span>

                    <input
                        type="text"
                        class="input-busqueda"
                        placeholder=""
                    />

                </div>


                <!-- Tablero -->
                <div class="tablero">


                    <!-- ========================= -->
                    <!-- COLUMNA: EN PROCESO       -->
                    <!-- ========================= -->

                    <div class="columna">

                        <h3 class="titulo-columna">
                            En Proceso
                        </h3>


                        <!-- Tarjeta -->
                        <div class="tarjeta">

                            <div class="informacion">

                                <p>
                                    <strong>Cliente:</strong>
                                </p>

                                <p>
                                    <strong>Origen:</strong>
                                </p>

                                <p>
                                    <strong>Destino:</strong>
                                </p>

                                <p>
                                    <strong>Anticipo dado a proveedor:</strong>
                                </p>

                                <p>
                                    <strong>Anticipo recibido de cliente:</strong>
                                </p>

                            </div>


                            <!-- Estado -->
                            <div class="estado">

                                <p>
                                    <strong>Estado:</strong>
                                </p>

                                <p>✓ Contrato con proveedor</p>
                                <p>→ En producción</p>
                                <p>○ Enviado</p>
                                <p>○ En tránsito</p>
                                <p>○ Entregado</p>

                            </div>


                            <!-- Aviso -->
                            <div class="aviso">
                                Necesita documentos
                            </div>


                            <!-- Botón -->
                            <button class="boton-pedido">
                                Ver Pedido
                            </button>

                        </div>

                    </div>


                    <!-- COLUMNA: EN PRODUCCIÓN    -->

                    <div class="columna">

                        <h3 class="titulo-columna">
                            En producción
                        </h3>


                        <!-- Tarjeta -->
                        <div class="tarjeta">

                            <div class="informacion">

                                <p>
                                    <strong>Cliente: Empresa</strong>
                                </p>

                                <p>
                                    <strong>Origen:</strong>
                                </p>

                                <p>
                                    <strong>Destino:</strong>
                                </p>

                                <p>
                                    <strong>Fecha de estimada:</strong>
                                </p>

                                <p>
                                    <strong>Anticipo dado:</strong>
                                </p>

                            </div>


                            <!-- Estado -->
                            <div class="estado">

                                <p>
                                    <strong>Estado:</strong>
                                </p>

                                <p>✓ Contrato con proveedor</p>
                                <p>✓ En producción</p>
                                <p>✓ Enviado</p>
                                <p>→ En tránsito</p>
                                <p>○ Entregado</p>

                            </div>


                            <!-- Aviso -->
                            <div class="aviso">
                                Necesita forwarden
                            </div>


                            <!-- Botón -->
                            <button class="boton-pedido">
                                Ver Pedido
                            </button>

                        </div>

                    </div>



                    <!-- ========================= -->
                    <!-- COLUMNA: TERMINADO        -->
                    <!-- ========================= -->

                    <div class="columna">

                        <h3 class="titulo-columna">
                            Terminado
                        </h3>


                        <!-- Tarjeta -->
                        <div class="tarjeta">

                            <div class="informacion">

                                <p>
                                    <strong>Cliente: Empresa</strong>
                                </p>

                                <p>
                                    <strong>Origen:</strong>
                                </p>

                                <p>
                                    <strong>Destino:</strong>
                                </p>

                                <p>
                                    <strong>Fecha de estimada:</strong>
                                </p>

                                <p>
                                    <strong>Anticipo dado:</strong>
                                </p>

                            </div>


                            <!-- Estado -->
                            <div class="estado">

                                <p>
                                    <strong>Estado:</strong>
                                </p>

                                <p>✓ Contrato con proveedor</p>
                                <p>✓ En producción</p>
                                <p>✓ Enviado</p>
                                <p>✓ En tránsito</p>
                                <p>✓ Entregado</p>

                            </div>


                            <!-- Aviso -->
                            <div class="aviso">
                                Terminado
                            </div>


                            <!-- Botón -->
                            <button class="boton-pedido">
                                Ver Pedido
                            </button>

                        </div>

                    </div>

