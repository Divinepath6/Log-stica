<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rastreo_pedido_form" model="ir.ui.view">
        <field name="name">rastreo.pedido.form</field>
        <field name="model">rastreo.pedido</field>
        <field name="arch" type="xml">
            <form string="Pedido" create="0" class="o_rastreo_form">
                <header>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="fase_inicial,produccion,puerto_origen,Embarcado,Descargado,Aduana,sin_pendiente"/>
                    <button name="%(action_pantalla_principal)d"
                            type="action"
                            string="Pantalla Principal"
                            class="btn-secondary"
                            icon="fa-home"/>
                </header>

                <sheet>
                    <div class="oe_title mb-4">
                        <label for="numero_guia" class="oe_edit_only" string="Número de Guía"/>
                        <h1>
                            <field name="numero_guia" placeholder="Ej. GUIA-001" class="text-primary"/>
                        </h1>
                    </div>
                    
                    <div class="o_rastreo_card o_rastreo_detalles mb-4">
                        <h3 class="o_rastreo_card_title">
                            <i class="fa fa-info-circle me-1"/> Detalles del pedido
                        </h3>
                        <group>
                            <group string="Cliente">
                                <field name="total_cliente"/>
                            </group>
                            <group string="Proveedor">
                                <!-- <field name="anticipo_proveedor"/> -->
                                <field name="total_proveedor"/>
                                <field name="forwarder"/>
                            </group>
                        </group>
                    </div>
                    <!-- Tarjeta PDFs -->
                    <div class="o_rastreo_card o_rastreo_pdfs mb-4">
                        <h3 class="o_rastreo_card_title">
                            <i class="fa fa-file-pdf-o me-1"/> PDFs del pedido
                        </h3>
                        <group>
                            <field name="pdf_contrato_proveedor" widget="rastreo_pdf_uploader"/>
                            <field name="pdf_factura_proveedor" widget="rastreo_pdf_uploader"/>
                        </group>
                    </div>
                    <separator string="Historial de actualizaciones" class="mt-4"/>
                    <field name="actualizacion_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="numero_actualizacion"/>
                            <field name="fecha_actualizacion"/>
                            <field name="actualizacion_texto"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>